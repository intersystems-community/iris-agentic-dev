*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*

# IDE
.idea/
.vscode/*.code-workspace
.vscode/settings.json
# Note: .vscode/launch.json and tasks.json ARE committed (debug support for contributors)
*.iml

# Profiling / logs
*.prof*
*.log
target/
.claude/settings.local.json
benchmark/021/results/
docs/*.txt
# Article drafts go in ~/writing/iris-agentic-dev/ — not tracked here
docs/roadmap-internal.md
*.profraw
# spec-gates enforcement runtime is TRACKED; the rest of .specify/ and .claude/
# is not. CI runs `bash .specify/gates/verify.sh` after a plain checkout with no
# install step, so the runtime has to be in the repo (the extension projects by
# copy, not symlink, so it is self-contained and does not need
# .specify/extensions/). .claude/hooks/gates/ is required too: canary.sh resolves
# the agent hooks from there and scores a missing one as a failure, not a skip.
# Directory patterns stop git descending, so these are `dir/*` plus negations.
/.specify/*
!/.specify/gates/
/.specify/gates/attestations.jsonl
.opencode/
/.claude/*
!/.claude/hooks/
# Nested agent dirs stay fully ignored. The rules above are root-anchored, so
# without this a subproject's .claude/ (e.g. the VS Code extension) would be
# un-ignored as a side effect.
*/.claude/
*/.specify/
vscode-iris-dev/*.vsix
*.exe
iris-dev-macos*
iris-dev-linux*
*.vsix
run_benchmark.py
*.pptx
/*.cls
/*.md
!ROADMAP.md
!CONTRIBUTING.md
!AGENTS.md
!CLAUDE.md
/Bench/
/EvalDemo/
/EvalDemo.*
/ListFilter.cls
/MyApp/
/example_patient*
/fixed_query*
/src/
/tests/Test/
.iris-dev/

# npx skills artifacts (local paths, machine-specific)
skills-lock.json
.agents/

# npm dependencies, at any depth. Previously only
# vscode-iris-agentic-dev/.gitignore covered node_modules, so the root
# npm install for the lint toolchain (package.json pins prettier +
# markdownlint-cli2) exposed 87 packages as untracked.
node_modules/

# Coverage and diagnostic artifacts
.coverage
tarpaulin-report.json
__pycache__/
*.pyc

# Browser-automation capture dumps (console logs + page snapshots, machine-specific)
.playwright-mcp/

# Mermaid VS Code extension output — machine-specific, not repo guidance
.github/instructions/mermaid.instructions.md
