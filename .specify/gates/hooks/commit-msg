#!/bin/bash
set -euo pipefail

# Behavioral probe (#74): doctor and project.sh run the hook git actually
# runs with GATES_PROBE=1, to prove the call chain reaches this script
# through whatever hook manager sits in between. It runs before any policy
# read, so it works with every rule turned off, and it can only refuse.
if [[ "${GATES_PROBE:-}" == "1" ]]; then
    _probe_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    echo "gates-probe:commit-msg:$(head -n 1 "$_probe_root/.specify/gates/.runtime-version" 2>/dev/null || echo unknown)" >&2
    exit 1
fi

# Git commit-msg hook.
# Validates commit message format, blocks AI-isms, emoji, and bad patterns
# (rules in lib/message.sh, shared with the PR checks), and enforces the
# protected-change trailers.

MSG_FILE="$1"
# git hands this hook the editor file BEFORE its own cleanup. Drop the
# scissors section (`git commit -v` diff) and comment lines so template text
# such as "# On branch feat/x" or diff content is never checked as message.
COMMENT_CHAR="$(git config core.commentChar 2>/dev/null || true)"
[[ ${#COMMENT_CHAR} -eq 1 ]] || COMMENT_CHAR='#'
MSG=$(awk -v c="$COMMENT_CHAR" '$0 == c " ------------------------ >8 ------------------------" { exit } { print }' "$MSG_FILE" \
    | git -c core.commentChar="$COMMENT_CHAR" stripspace --strip-comments 2>/dev/null) || MSG=$(cat "$MSG_FILE")

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# The git boundary judges the repository being committed. An inherited
# CLAUDE_PROJECT_DIR (a session in the main checkout committing in a linked
# worktree, or `git -C <other repo>`) would otherwise select another
# checkout's policy, since the policy loader prefers it.
if git rev-parse --show-toplevel >/dev/null 2>&1; then
    export CLAUDE_PROJECT_DIR="$PROJECT_ROOT"
fi
# GATES_POLICY_FILE replaces the whole policy (#196), so one variable on a
# commit would drop every rule. The git boundary judges the policy the
# repository commits: it ignores the variable, and says so.
if [[ -n "${GATES_POLICY_FILE:-}" ]]; then
    echo "gates: GATES_POLICY_FILE=$GATES_POLICY_FILE is ignored at the git boundary; the repository's policy applies" >&2
    unset GATES_POLICY_FILE
fi
POLICY_LIB="$PROJECT_ROOT/.specify/gates/lib/policy.sh"
# shellcheck source=/dev/null disable=SC1091
[[ -f "$POLICY_LIB" ]] && source "$POLICY_LIB"

MESSAGE_LIB="$PROJECT_ROOT/.specify/gates/lib/message.sh"
RUNTIME_VERSION="$(head -n 1 "$PROJECT_ROOT/.specify/gates/.runtime-version" 2>/dev/null || true)"

# True when version $1 is older than $2 (numeric major.minor.patch).
version_lt() {
    local a b i x y
    IFS=. read -r -a a <<<"$1"
    IFS=. read -r -a b <<<"$2"
    for i in 0 1 2; do
        x="${a[$i]:-0}"
        y="${b[$i]:-0}"
        x="${x%%[!0-9]*}"
        y="${y%%[!0-9]*}"
        [[ "${x:-0}" -lt "${y:-0}" ]] && return 0
        [[ "${x:-0}" -gt "${y:-0}" ]] && return 1
    done
    return 1
}

# --- The runtime this hook needs (issue #159) ---
# A branch that tracks something under .specify/gates (in HEAD or the index,
# the stub's adoption test) has adopted gates; without its libraries it was
# never projected, as in a fresh clone of a repo that gitignores the
# runtime. Every projection records .runtime-version, so a missing one is
# no sign of an older runtime: refuse rather than skip the rules. Only a
# runtime that names a version before 0.3.4 lacks lib/message.sh by design.
MISSING=""
[[ -f "$POLICY_LIB" ]] || MISSING="lib/policy.sh"
if [[ ! -f "$MESSAGE_LIB" ]] \
    && { [[ -z "$RUNTIME_VERSION" ]] || ! version_lt "$RUNTIME_VERSION" 0.3.4; }; then
    MISSING="${MISSING:+$MISSING }lib/message.sh"
fi
if [[ -n "$MISSING" ]] \
    && { git rev-parse -q --verify "HEAD:.specify/gates" >/dev/null 2>&1 \
        || [[ -n "$(git ls-files -- ':(top).specify/gates' 2>/dev/null)" ]]; }; then
    echo "ERROR: commit-msg refused -- .specify/gates is tracked but the runtime is not projected (missing: $MISSING)." >&2
    echo "  Project it: bash .specify/extensions/gates/runtime/project.sh" >&2
    exit 1
fi

# --- Subjects git writes itself (issue #129) ---
# A merge commit ("Merge branch ..."), detected by MERGE_HEAD in the git dir
# rather than by its subject, and the fixup!/squash!/amend! prefixes of
# `git commit --fixup/--squash` are not Conventional Commits and are not
# meant to be. They skip the subject-format rule; every other rule applies.
# A prefix counts only when the rest of the subject is the subject of an
# existing commit, which is what git writes (#170): `fixup! anything` typed
# by hand is judged like any other subject. Nested prefixes (`fixup! fixup!
# x`) match too, since the commit they name carries the inner prefix.
MERGE_HEAD_FILE="$(git rev-parse --git-path MERGE_HEAD 2>/dev/null || true)"
GENERATED=""
if [[ -n "$MERGE_HEAD_FILE" && -f "$MERGE_HEAD_FILE" ]]; then
    GENERATED=merge
else
    SUBJECT="${MSG%%$'\n'*}"
    case "$SUBJECT" in
        "fixup! "* | "squash! "* | "amend! "*)
            if grep -qxF -- "${SUBJECT#* }" <<<"$(git log --format=%s 2>/dev/null || true)"; then
                GENERATED=fixup
            fi
            ;;
    esac
fi

# --- Message rules (shared with validate-pr.sh and pr-check.sh) ---
if [[ -f "$MESSAGE_LIB" ]]; then
    # shellcheck source=/dev/null disable=SC1091
    source "$MESSAGE_LIB"
    gates_message_check commit "$MSG" ${GENERATED:+generated} || true
    ERRORS="$GATES_MSG_ERRORS"
    WARNINGS="$GATES_MSG_WARNINGS"
elif [[ -z "$RUNTIME_VERSION" ]] || version_lt "$RUNTIME_VERSION" 0.3.4; then
    # .git/hooks is shared by every branch, the projected runtime is not: a
    # branch still on a pre-0.3.4 runtime (cut before the upgrade landed) has
    # no lib/message.sh. Refusing every commit there would strand it, so the
    # message rules that runtime never had are skipped, loudly. Unversioned
    # gets here only on a branch that tracks nothing under .specify/gates.
    echo "WARN: this branch's gates runtime (${RUNTIME_VERSION:-unversioned}) predates the installed commit-msg hook;" >&2
    echo "  message rules skipped. Rebase onto the upgraded branch or run /speckit.gates.upgrade." >&2
    ERRORS=0
    WARNINGS=1
else
    # A 0.3.4+ runtime without its message lib is a broken projection: fail closed.
    echo "ERROR: $MESSAGE_LIB not found but the runtime is $RUNTIME_VERSION -- re-project it (/speckit.gates.upgrade)." >&2
    exit 1
fi

# --- Protected files (policy: protected_files.extra, git.protected_change_trailer) ---
# Issue #47. The agent boundary refuses protected edits outright; at the git
# boundary a human commits, so a staged protected path passes only when the
# message's trailer block declares it ("Protected-Change: <path>", one per
# path) and names an approver ("Approved-By: <name>"). The trailer is an
# auditable declaration, not a credential: real approval is CODEOWNERS plus
# branch protection on the server.
TRAILER_ON=gates_protected_trailer_enabled
# On when HEAD's policy has it on too, so the commit that turns the rule
# off needs its trailers (#172); pre-commit applies the same switch.
command -v gates_protected_trailer_enabled_commit >/dev/null 2>&1 \
    && TRAILER_ON=gates_protected_trailer_enabled_commit
if command -v gates_protected_check >/dev/null 2>&1 \
    && "$TRAILER_ON"; then
    PROTECTED_STAGED="$(gates_staged_protected_paths)"
    if [[ "$GENERATED" == merge && -n "$PROTECTED_STAGED" ]]; then
        # A merge brings in the other side's commits, which carry their own
        # declarations (and pr-check re-checks every commit in the range).
        # Only a protected path that differs from EVERY merged parent, an
        # edit made while resolving the merge, needs one here. A parent
        # that cannot be compared keeps the full list.
        while IFS= read -r _parent; do
            [[ -z "$_parent" ]] && continue
            if _differs="$(git diff --cached --name-only --no-renames "$_parent" 2>/dev/null)"; then
                PROTECTED_STAGED="$(awk 'FNR == NR { d[$0] = 1; next } ($0 in d)' \
                    <(printf '%s\n' "$_differs") <(printf '%s\n' "$PROTECTED_STAGED"))"
            fi
        done <"$MERGE_HEAD_FILE"
    fi
    # --no-divider: a `---` line in the body is prose here, not a patch start.
    TRAILERS="$(git interpret-trailers --parse --no-divider "$MSG_FILE" 2>/dev/null || true)"
    DECLARED="$(printf '%s\n' "$TRAILERS" | gates_trailer_values protected-change)"
    APPROVERS="$(printf '%s\n' "$TRAILERS" | gates_trailer_values approved-by)"
    if [[ -n "$PROTECTED_STAGED" || -n "$DECLARED" ]]; then
        # Paths this commit changes. HEAD's own changes count too, so
        # `git commit --amend` of a declared commit is not refused for a
        # trailer whose file is no longer in the (amend-relative) index diff.
        CHANGED="$(git diff --cached --name-only --no-renames 2>/dev/null || true)"
        CHANGED="$CHANGED"$'\n'"$(git diff --name-only --no-renames HEAD^ HEAD 2>/dev/null || true)"
        _rc=0
        gates_protected_check "$PROTECTED_STAGED" "$CHANGED" "$DECLARED" "$APPROVERS" || _rc=$?
        ERRORS=$((ERRORS + _rc))
    fi
fi

# --- Project-owned rules (#71): .specify/gates/hooks.local.d/commit-msg/ ---
# Each rule gets the message file as $1, like the hook itself.
if compgen -G "$PROJECT_ROOT/.specify/gates/hooks.local.d/commit-msg/*.sh" >/dev/null; then
    LLIB="$PROJECT_ROOT/.specify/gates/lib/local-hooks.sh"
    if [[ -f "$LLIB" ]] && "$BASH" -n "$LLIB" 2>/dev/null; then
        # shellcheck source=/dev/null disable=SC1090
        source "$LLIB"
        if ! gates_run_local "$PROJECT_ROOT" commit-msg "$MSG_FILE"; then
            echo "BLOCKED: $GATES_LOCAL_MSG" >&2
            ERRORS=$((ERRORS + 1))
        fi
    else
        echo "BLOCKED: local rules exist in hooks.local.d/commit-msg, but lib/local-hooks.sh cannot load" >&2
        ERRORS=$((ERRORS + 1))
    fi
fi

# --- Result ---
if [[ "$ERRORS" -gt 0 ]]; then
    echo "" >&2
    echo "Commit message validation failed: $ERRORS error(s), $WARNINGS warning(s)." >&2
    exit 1
fi

if [[ "$WARNINGS" -gt 0 ]]; then
    echo "Commit message accepted with $WARNINGS warning(s)." >&2
fi

exit 0
