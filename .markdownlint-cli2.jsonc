{
  // Project markdownlint config — matches global ~/.markdownlint-cli2.jsonc rules.
  "ignores": [".specify/gates/**", ".specify/extensions/**", ".claude/hooks/gates/**"],
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    // Underscore, not asterisk: prettier always emits `_em_` and has no option to
    // change it, so "asterisk" here made the two mandated commands permanently
    // contradict each other — prettier --write then markdownlint --fix looped.
    "MD049": { "style": "underscore" },
    "MD050": { "style": "asterisk" },
    "MD060": false
  }
}
