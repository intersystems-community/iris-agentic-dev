{
  // Project markdownlint config — matches global ~/.markdownlint-cli2.jsonc rules.
  "ignores": [".specify/gates/**", ".specify/extensions/**", ".claude/hooks/gates/**"],
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD049": { "style": "asterisk" },
    "MD050": { "style": "asterisk" },
    "MD060": false
  }
}
